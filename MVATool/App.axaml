<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MVATool.App"
             RequestedThemeVariant="Dark">

    <!--
        BẢNG MÀU "CÔNG NGHIỆP" của MVAVision — đặt ở App để mọi Window dùng chung.
        ThemeDictionaries: mỗi theme (Dark/Light) một bộ giá trị cho CÙNG một key;
        View chỉ cần {DynamicResource MvaXxx} là tự đổi màu khi người dùng bấm 🌓.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- Theme tối: phong cách HMI công nghiệp — nền than chì, nhấn cyan -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MvaWindowBrush" Color="#0C1218" />
                    <SolidColorBrush x:Key="MvaHeaderBrush" Color="#111A23" />
                    <SolidColorBrush x:Key="MvaPanelBrush" Color="#141D27" />
                    <SolidColorBrush x:Key="MvaPanelAltBrush" Color="#1A2532" />
                    <SolidColorBrush x:Key="MvaBorderBrush" Color="#28374A" />
                    <SolidColorBrush x:Key="MvaViewportBrush" Color="#080D12" />
                    <SolidColorBrush x:Key="MvaAccentBrush" Color="#00C2E8" />
                    <SolidColorBrush x:Key="MvaTextMutedBrush" Color="#7E93A8" />
                </ResourceDictionary>

                <!-- Theme sáng: cùng bộ key, giá trị dịu mắt hơn cho môi trường văn phòng -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MvaWindowBrush" Color="#E7EBEF" />
                    <SolidColorBrush x:Key="MvaHeaderBrush" Color="#F4F7FA" />
                    <SolidColorBrush x:Key="MvaPanelBrush" Color="#FCFDFE" />
                    <SolidColorBrush x:Key="MvaPanelAltBrush" Color="#ECF1F5" />
                    <SolidColorBrush x:Key="MvaBorderBrush" Color="#C4CFDA" />
                    <SolidColorBrush x:Key="MvaViewportBrush" Color="#D8DEE5" />
                    <SolidColorBrush x:Key="MvaAccentBrush" Color="#007FAD" />
                    <SolidColorBrush x:Key="MvaTextMutedBrush" Color="#5B6E80" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- Màu đèn LED trạng thái — chuẩn tín hiệu máy móc, giống nhau ở cả 2 theme -->
            <SolidColorBrush x:Key="MvaOkBrush" Color="#2ECC71" />
            <SolidColorBrush x:Key="MvaBusyBrush" Color="#F5A623" />
            <SolidColorBrush x:Key="MvaDangerBrush" Color="#E8503A" />

            <!-- Font số liệu kỹ thuật (tọa độ pixel, đồng hồ, thông số hệ thống) -->
            <FontFamily x:Key="MvaMonoFont">Consolas, Cascadia Mono, Courier New, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

</Application>
