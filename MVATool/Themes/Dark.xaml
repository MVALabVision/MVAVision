<!-- Theme TỐI theo nhận diện MVA LAB: nền NAVY sâu (màu khối phải của logo),
     nhấn XANH ROYAL (khối trái + mắt camera), điểm xuyết VÀNG GOLD cho đường kẻ / nút chính.
     Cùng bộ key với Light.xaml; App đổi theme bằng cách thay dictionary này. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Nền / chữ ===== -->
    <SolidColorBrush x:Key="MvaWindowBrush" Color="#060C1A" />
    <SolidColorBrush x:Key="MvaHeaderBrush" Color="#09132B" />
    <SolidColorBrush x:Key="MvaPanelBrush" Color="#0B1631" />
    <SolidColorBrush x:Key="MvaPanelAltBrush" Color="#0F1D40" />
    <SolidColorBrush x:Key="MvaBorderBrush" Color="#1D3266" />
    <SolidColorBrush x:Key="MvaViewportBrush" Color="#040915" />
    <SolidColorBrush x:Key="MvaTextBrush" Color="#EAF0FB" />
    <SolidColorBrush x:Key="MvaTextMutedBrush" Color="#8597BF" />

    <!-- ===== Xanh thương hiệu ===== -->
    <SolidColorBrush x:Key="MvaAccentBrush" Color="#3D8BFF" />
    <SolidColorBrush x:Key="MvaSelectionBrush" Color="#333D8BFF" />
    <LinearGradientBrush x:Key="MvaBrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E90FF" Offset="0" />
        <GradientStop Color="#1747D9" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Vàng gold — chỉ dùng điểm xuyết (đường kẻ, nút chính, mục đang chọn) ===== -->
    <SolidColorBrush x:Key="MvaGoldBrush" Color="#D4AF37" />
    <SolidColorBrush x:Key="MvaGoldLightBrush" Color="#F2D47E" />
    <SolidColorBrush x:Key="MvaGoldSoftBrush" Color="#2BD4AF37" />
    <SolidColorBrush x:Key="MvaOnGoldBrush" Color="#1B1404" />
    <LinearGradientBrush x:Key="MvaGoldGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F6DE92" Offset="0" />
        <GradientStop Color="#D4AF37" Offset="0.55" />
        <GradientStop Color="#A8842A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MvaGoldHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFEBB0" Offset="0" />
        <GradientStop Color="#E6C251" Offset="0.55" />
        <GradientStop Color="#BD9634" Offset="1" />
    </LinearGradientBrush>

    <!-- Logo chữ: bản đảo màu (phần đen → trắng) để đọc được trên nền tối -->
    <BitmapImage x:Key="MvaWordmarkImage" UriSource="pack://application:,,,/Assets/mva-wordmark-dark.png" />

</ResourceDictionary>
