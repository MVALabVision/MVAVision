<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- WPF chỉ chạy trên Windows → TFM phải có hậu tố -windows -->
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- MVVM toolkit: ObservableObject, [ObservableProperty], [RelayCommand] -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />

        <!-- DI container — dùng trong composition root (App.xaml.cs) -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />

        <!-- OpenCV: managed wrapper + native runtime cho Windows -->
        <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    </ItemGroup>

    <ItemGroup>
        <!-- Tầng thuật toán — app chỉ THAM CHIẾU, không chứa thuật toán -->
        <ProjectReference Include="..\MVATool.Core\MVATool.Core.csproj" />
    </ItemGroup>

</Project>
